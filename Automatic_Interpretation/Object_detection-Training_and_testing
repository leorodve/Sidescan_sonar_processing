t\n","        in [0, 1]\n","    \"\"\"\n","#    try:\n","    assert bb1[0] < bb1[1]\n","    assert bb1[2] < bb1[3]\n","    assert bb2[0] < bb2[1]\n","    assert bb2[2] < bb2[3]\n","\n","    # determine the coordinates of the intersection rectangle\n","    x_left = max(bb1[0], bb2[0])\n","    x_right = min(bb1[1], bb2[1])\n","    y_bottom = max(bb1[2], bb2[2])\n","    y_top = min(bb1[3], bb2[3])\n","\n","    if x_right < x_left or y_top < y_bottom:\n","        return 0.0, x_left, y_bottom, x_right, y_top\n","\n","    # The intersection of two axis-aligned bounding boxes is always an\n","    # axis-aligned bounding box\n","    intersection_area = (x_right - x_left) * (y_top - y_bottom)\n","\n","    # compute the area of both AABBs\n","    bb1_area = (bb1[1] - bb1[0]) * (bb1[3] - bb1[2])\n","    bb2_area = (bb2[1] - bb2[0]) * (bb2[3] - bb2[2])\n","\n","    # compute the intersection over union by taking the intersection\n","    # area and dividing it by the sum of prediction + ground-truth\n","    # areas - the interesection area\n","    iou = intersection_area / float(bb1_area + bb2_area - intersection_area)\n","    assert iou >= 0.0\n","    assert iou <= 1.0\n","    return iou, x_left, y_bottom, x_right, y_top\n","    #except:\n","    #  AssertionError\n","    #  pass"]},{"cell_type":"markdown","metadata":{"id":"1FvI2qsVoIGf"},"source":["**STEP 2:** Merge detections from 3 models and save confidence level"]},{"cell_type":"markdown","metadata":{"id":"J-NOyVUPRQxk"},"source":["Left side boxes"]},{"cell_type":"code","execution_count":null,"metadata":{"id":"8wwcuJt2V0D_"},"outputs":[],"source":["left_boxes = []\n","idx = []\n","\n","for i in range(left_boxes_20x20.shape[0]//4):\n","  highest_iou = 0\n","  pred_bbox_20x20 = np.array([left_boxes_20x20[i*4+2], left_boxes_20x20[i*4], left_boxes_20x20[i*4 + 1], left_boxes_20x20[i*4 + 3]])\n","  for a in range(left_boxes_30x30.shape[0]//4):\n","    pred_bbox_30x30 = np.array([left_boxes_30x30[a*4+2], left_boxes_30x30[a*4], lef